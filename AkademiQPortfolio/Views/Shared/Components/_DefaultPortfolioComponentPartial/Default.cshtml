@model List<Work>
<section id="section6">
    <div class="container">
        <h2>Projelerim</h2>

        <div class="portfolio-wrapper">

            <!-- FILTER BUTTONS -->
            <div id="portfolio-filters" class="portfolio-filters">
                <button class="button solid-button white-purple small" data-filter="*">Show All</button>
                <button class="button solid-button white-purple small" data-filter=".mobil">Mobil</button>
                <button class="button solid-button white-purple small" data-filter=".web">Web Uygulaması</button>
                <button class="button solid-button white-purple small" data-filter=".data">Veri Analizi</button>
                <button class="button solid-button white-purple small" data-filter=".design">Tasarımlarım</button>
            </div>

            <!-- PORTFOLIO -->
            <div id="portfolio" class="portfolio">

                @foreach (var item in Model)
                {
                    <!-- 
                    SubTitle Örnekleri:
                    mobil | web | data | design
                    -->
                    <div class="item @item.SubTitle?.ToLower()">
                        <img src="@item.ImageUrl" alt="@item.Title" class="img-responsive">

                        <a href="#" class="overlay">
                            <div class="background"></div>
                            <div class="meta">
                                <span class="title">@item.Title</span>
                                <span class="category">@item.SubTitle</span>
                            </div>
                        </a>
                    </div>
                }

            </div>

        </div>
    </div>
</section>