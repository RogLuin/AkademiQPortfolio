@model Message

<section id="section8" class="contact-section">
    <div class="container">
        <!-- Section Header -->
        <div class="row">
            <div class="col-md-12 text-center">
                <span class="section-badge">İLETİŞİM</span>
                <h2 class="section-title">Birlikte Çalışalım</h2>
                <p class="section-subtitle">
                    Projeniz hakkında konuşmak ister misiniz? <br>
                    Size <strong>24 saat içinde</strong> dönüş yapacağım.
                </p>
            </div>
        </div>

        <div class="row" style="margin-top: 60px;">
            <!-- Left: Contact Info -->
            <div class="col-lg-5 col-md-12">
                <div class="contact-info-wrapper">
                    <div class="contact-info-header">
                        <h3>İletişim Bilgileri</h3>
                        <p>Aşağıdaki kanallardan bana ulaşabilirsiniz.</p>
                    </div>

                    <div class="contact-info-list">
                        <!-- Email -->
                        <a href="mailto:gorkemdikbakan@gmail.com" class="contact-info-item">
                            <div class="contact-icon">
                                <i class="fa fa-envelope"></i>
                            </div>
                            <div class="contact-details">
                                <span class="contact-label">E-Posta</span>
                                <span class="contact-value">gorkemdikbakan@gmail.com</span>
                            </div>
                            <i class="fa fa-arrow-right contact-arrow"></i>
                        </a>

                        <!-- Location -->
                        <div class="contact-info-item">
                            <div class="contact-icon">
                                <i class="fa fa-map-marker"></i>
                            </div>
                            <div class="contact-details">
                                <span class="contact-label">Konum</span>
                                <span class="contact-value">Türkiye</span>
                            </div>
                        </div>

                        <!-- Response Time -->
                        <div class="contact-info-item">
                            <div class="contact-icon">
                                <i class="fa fa-clock-o"></i>
                            </div>
                            <div class="contact-details">
                                <span class="contact-label">Yanıt Süresi</span>
                                <span class="contact-value">24 saat içinde</span>
                            </div>
                        </div>
                    </div>

                    <!-- Social Links -->
                    <div class="contact-social">
                        <span class="social-label">Sosyal Medya</span>
                        <div class="social-links">
                            <a href="#" class="social-link" title="GitHub">
                                <i class="fa fa-github"></i>
                            </a>
                            <a href="#" class="social-link" title="LinkedIn">
                                <i class="fa fa-linkedin"></i>
                            </a>
                            <a href="#" class="social-link" title="Twitter">
                                <i class="fa fa-twitter"></i>
                            </a>
                            <a href="#" class="social-link" title="Instagram">
                                <i class="fa fa-instagram"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Contact Form -->
            <div class="col-lg-7 col-md-12">
                <div class="contact-form-wrapper">
                    <form method="post" asp-controller="Message" asp-action="CreateMessage" class="modern-form">
                        <div class="form-header">
                            <h4>Mesaj Gönderin</h4>
                            <p>Formu doldurun, size en kısa sürede dönüş yapayım.</p>
                        </div>

                        <div class="form-grid">
                            <!-- Name -->
                            <div class="form-group">
                                <label class="form-label">İsim Soyisim</label>
                                <div class="input-wrapper">
                                    <i class="fa fa-user input-icon"></i>
                                    <input type="text" name="SenderName" placeholder="   Adınız Soyadınız" required class="form-input">
                                </div>
                            </div>

                            <!-- Email -->
                            <div class="form-group">
                                <label class="form-label">E-Posta Adresi</label>
                                <div class="input-wrapper">
                                    <i class="fa fa-envelope input-icon"></i>
                                    <input type="email" name="SenderEmail" placeholder="   email@example.com" required class="form-input">
                                </div>
                            </div>
                        </div>

                        <!-- Subject -->
                        <div class="form-group full-width">
                            <label class="form-label">Konu</label>
                            <div class="input-wrapper">
                                <i class="fa fa-tag input-icon"></i>
                                <select name="MessageSubject" required class="form-input form-select">
                                    <option value="" disabled selected>Konu seçiniz...</option>
                                    <option value="Proje Teklifi">💼 Proje Teklifi</option>
                                    <option value="Web / API Geliştirme">🌐 Web / API Geliştirme</option>
                                    <option value="Eğitim / Kurumsal Talep">🎓 Eğitim / Kurumsal Talep</option>
                                    <option value="Teknik Destek">🛠️ Teknik Destek / Danışmanlık</option>
                                    <option value="Diğer">📝 Diğer</option>
                                </select>
                            </div>
                        </div>

                        <!-- Message -->
                        <div class="form-group full-width">
                            <label class="form-label">Mesajınız</label>
                            <div class="input-wrapper textarea-wrapper">
                                <i class="fa fa-comment input-icon"></i>
                                <textarea name="MessageText" rows="5" placeholder="Projeniz hakkında detaylı bilgi verin..." required class="form-input form-textarea"></textarea>
                            </div>
                        </div>

                        <!-- Submit -->
                        <div class="form-actions">
                            <button type="submit" class="submit-btn">
                                <span>Mesajı Gönder</span>
                                <i class="fa fa-paper-plane"></i>
                            </button>
                        </div>

                        <!-- Alerts -->
                        <div class="form-alerts">
                            <div class="contact-loading alert alert-info form-alert">
                                <i class="fa fa-spinner fa-spin"></i>
                                <span>Gönderiliyor...</span>
                            </div>
                            <div class="contact-success alert alert-success form-alert">
                                <i class="fa fa-check-circle"></i>
                                <span>Mesajınız başarıyla gönderildi!</span>
                            </div>
                            <div class="contact-error alert alert-danger form-alert">
                                <i class="fa fa-exclamation-circle"></i>
                                <span>Bir hata oluştu. Lütfen tekrar deneyin.</span>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const messageSent = '@TempData["MessageSent"]';
        if (messageSent) {
            Swal.fire({
                title: 'Başarılı! ✓',
                text: messageSent,
                icon: 'success',
                confirmButtonText: 'Tamam',
                background: '#ffffff',
                color: '#0f172a',
                confirmButtonColor: '#334155',
                iconColor: '#22c55e',
                showClass: {
                    popup: 'animate__animated animate__fadeInDown'
                }
            });
        }
    });
    
</script>
