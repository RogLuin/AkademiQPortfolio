@model List<Education>

<section id="section5">
    <div class="container">
        <h2>Eğitim Hayatım</h2>

        <div class="education clearfix">

            @foreach (var item in Model)
            {
                <div class="item">
                    <div class="marker"></div>
                    <div class="content">
                        <span>@item.Title</span>
                        <h4>@item.Department</h4>
                    </div>
                    <div class="year">@item.EducationDate</div>
                </div>
            }

            <div class="line"></div>
        </div>
        <!-- end .education -->

        <h2>Hobilerim ve İlgi Alanlarım </h2>

        <div class="row">
            <div class="col-sm-2 col-sm-offset-1 col-xs-6">
                <div class="icon-box">
                    <div class="icon"><i class="ion-easel"></i></div>
                    <h6>Araştırma</h6>
                </div>
            </div>

            <div class="col-sm-2 col-xs-6">
                <div class="icon-box">
                    <div class="icon"><i class="ion-ios-camera-outline"></i></div>
                    <h6>Fotoğraf</h6>
                </div>
            </div>

            <div class="col-sm-2 col-xs-6">
                <div class="icon-box">
                    <div class="icon"><i class="ion-plane"></i></div>
                    <h6>Seyehat</h6>
                </div>
            </div>

            <div class="col-sm-2 col-xs-6">
                <div class="icon-box">
                    <div class="icon"><i class="ion-ios-bookmarks-outline"></i></div>
                    <h6>Kitap Okuma</h6>
                </div>
            </div>

            <div class="col-sm-2 col-xs-6">
                <div class="icon-box">
                    <div class="icon"><i class="ion-ios-musical-notes"></i></div>
                    <h6>Muzik</h6>
                </div>
            </div>
        </div>
        <!-- end .row -->
    </div>
    <!-- end .container -->
</section>
