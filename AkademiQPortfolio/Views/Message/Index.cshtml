@model IEnumerable<AkademiQPortfolio.Entities.Message>
@{
    ViewData["Title"] = "Mesajlar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    /* Base Container */
    .inbox-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #0a0a12 0%, #12121e 50%, #0d1117 100%);
        position: relative;
        overflow: hidden;
    }

    /* Ambient Glow */
    .ambient-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        pointer-events: none;
        z-index: 0;
    }

    .glow-1 {
        width: 450px;
        height: 450px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.1) 0%, transparent 70%);
        top: -15%;
        left: -10%;
        animation: pulse-glow 8s ease-in-out infinite;
    }

    .glow-2 {
        width: 350px;
        height: 350px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.08) 0%, transparent 70%);
        bottom: -10%;
        right: -5%;
        animation: pulse-glow 10s ease-in-out infinite;
        animation-delay: 3s;
    }

    @@keyframes pulse-glow {
        0%, 100% { opacity: 0.5; transform: scale(1); }
        50% { opacity: 1; transform: scale(1.1); }
    }

    /* Header */
    .page-header {
        position: relative;
        z-index: 10;
        padding: 32px 40px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        background: rgba(10, 10, 18, 0.8);
        backdrop-filter: blur(20px);
    }

    .header-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: 1200px;
        margin: 0 auto;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .header-icon {
        width: 56px;
        height: 56px;
        border-radius: 18px;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.2), rgba(139, 92, 246, 0.2));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: #a5b4fc;
        box-shadow: 0 8px 32px rgba(99, 102, 241, 0.15);
    }

    .header-text h1 {
        font-size: 1.75rem;
        font-weight: 700;
        color: white;
        margin: 0 0 4px 0;
        letter-spacing: -0.02em;
    }

    .header-text p {
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.5);
        margin: 0;
    }

    .header-stats {
        display: flex;
        gap: 12px;
    }

    .stat-badge {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 12px;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .stat-badge.total {
        background: rgba(99, 102, 241, 0.1);
        border: 1px solid rgba(99, 102, 241, 0.2);
        color: #a5b4fc;
    }

    .stat-badge.unread {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.2);
        color: #fca5a5;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        background: #ef4444;
        border-radius: 50%;
        animation: pulse-dot 2s infinite;
    }

    @@keyframes pulse-dot {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }

    /* Main Content */
    .main-content {
        position: relative;
        z-index: 5;
        padding: 32px 40px 80px;
        max-width: 1200px;
        margin: 0 auto;
    }

    /* Filter Tabs */
    .filter-tabs {
        display: flex;
        gap: 8px;
        margin-bottom: 24px;
        animation: fadeInUp 0.4s ease-out;
    }

    .filter-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .filter-btn:hover {
        background: rgba(255, 255, 255, 0.06);
        color: white;
    }

    .filter-btn.active {
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.2), rgba(139, 92, 246, 0.2));
        border-color: rgba(99, 102, 241, 0.3);
        color: white;
    }

    /* Messages Card */
    .messages-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 24px;
        overflow: hidden;
        animation: fadeInUp 0.5s ease-out 0.1s both;
    }

    /* Message Item */
    .message-item {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 20px 24px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        animation: fadeInUp 0.4s ease-out forwards;
    }

    .message-item:last-child {
        border-bottom: none;
    }

    .message-item:hover {
        background: rgba(255, 255, 255, 0.03);
    }

    .message-item.unread {
        background: rgba(99, 102, 241, 0.03);
    }

    .message-item.unread::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;
        background: linear-gradient(180deg, #6366f1, #8b5cf6);
    }

    /* Avatar */
    .avatar-wrapper {
        position: relative;
        flex-shrink: 0;
    }

    .avatar {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .avatar.unread {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: white;
        box-shadow: 0 8px 25px rgba(99, 102, 241, 0.3);
    }

    .avatar.read {
        background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.6);
    }

    .unread-badge {
        position: absolute;
        top: -4px;
        right: -4px;
        width: 16px;
        height: 16px;
        background: #6366f1;
        border: 3px solid #0a0a12;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .unread-badge::after {
        content: '';
        width: 6px;
        height: 6px;
        background: white;
        border-radius: 50%;
    }

    /* Message Content */
    .message-content {
        flex: 1;
        min-width: 0;
    }

    .message-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 4px;
    }

    .sender-name {
        font-size: 1rem;
        font-weight: 600;
        color: white;
        margin: 0;
    }

    .message-item.read .sender-name {
        color: rgba(255, 255, 255, 0.8);
    }

    .subject-badge {
        padding: 4px 10px;
        border-radius: 8px;
        font-size: 0.65rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .subject-badge.job {
        background: rgba(99, 102, 241, 0.15);
        color: #a5b4fc;
        border: 1px solid rgba(99, 102, 241, 0.25);
    }

    .subject-badge.dev {
        background: rgba(16, 185, 129, 0.15);
        color: #6ee7b7;
        border: 1px solid rgba(16, 185, 129, 0.25);
    }

    .subject-badge.edu {
        background: rgba(245, 158, 11, 0.15);
        color: #fcd34d;
        border: 1px solid rgba(245, 158, 11, 0.25);
    }

    .subject-badge.other {
        background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .sender-email {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.4);
        margin: 0 0 4px 0;
    }

    .message-preview {
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.35);
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 500px;
    }

    /* Message Meta */
    .message-meta {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-shrink: 0;
    }

    .message-time {
        text-align: right;
    }

    .message-time .date {
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.4);
        margin-bottom: 2px;
    }

    .message-time .time {
        font-size: 0.7rem;
        color: rgba(255, 255, 255, 0.25);
    }

    /* Action Buttons */
    .action-btns {
        display: flex;
        gap: 8px;
        opacity: 0;
        transition: opacity 0.2s ease;
    }

    .message-item:hover .action-btns {
        opacity: 1;
    }

    .action-btn {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
    }

    .action-btn.view {
        background: rgba(59, 130, 246, 0.1);
        color: #60a5fa;
    }

    .action-btn.view:hover {
        background: rgba(59, 130, 246, 0.2);
        transform: translateY(-2px);
    }

    .action-btn.delete {
        background: rgba(239, 68, 68, 0.1);
        color: #f87171;
    }

    .action-btn.delete:hover {
        background: rgba(239, 68, 68, 0.2);
        transform: translateY(-2px);
    }

    /* Empty State */
    .empty-state {
        padding: 80px 40px;
        text-align: center;
    }

    .empty-icon {
        width: 100px;
        height: 100px;
        margin: 0 auto 24px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.05);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        color: rgba(255, 255, 255, 0.3);
    }

    .empty-state h3 {
        font-size: 1.25rem;
        font-weight: 600;
        color: white;
        margin: 0 0 8px 0;
    }

    .empty-state p {
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.4);
        margin: 0;
    }

    /* Modal */
    .modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .modal-overlay.active {
        display: flex;
    }

    .modal-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(8px);
    }

    .modal-container {
        position: relative;
        width: 100%;
        max-width: 640px;
        max-height: 90vh;
        background: linear-gradient(135deg, #151525 0%, #1a1a2e 100%);
        border-radius: 28px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 25px 80px rgba(0, 0, 0, 0.5);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        animation: modal-enter 0.3s ease;
    }

    @@keyframes modal-enter {
        from {
            opacity: 0;
            transform: scale(0.95) translateY(20px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    .modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 24px 28px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        background: rgba(255, 255, 255, 0.02);
    }

    .modal-header-left {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .modal-avatar {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: 600;
        color: white;
        box-shadow: 0 8px 25px rgba(99, 102, 241, 0.3);
    }

    .modal-sender-name {
        font-size: 1.1rem;
        font-weight: 600;
        color: white;
        margin: 0 0 4px 0;
    }

    .modal-sender-email {
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.5);
        margin: 0;
    }

    .modal-close {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.05);
        border: none;
        color: rgba(255, 255, 255, 0.5);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        font-size: 1.1rem;
    }

    .modal-close:hover {
        background: rgba(255, 255, 255, 0.1);
        color: white;
    }

    .modal-body {
        flex: 1;
        overflow-y: auto;
        padding: 28px;
    }

    .modal-meta {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
    }

    .modal-date {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.4);
    }

    .modal-message-box {
        background: rgba(255, 255, 255, 0.03);
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.06);
        padding: 24px;
    }

    .modal-message-text {
        font-size: 0.95rem;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.8);
        margin: 0;
        white-space: pre-wrap;
    }

    .modal-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 28px;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        background: rgba(255, 255, 255, 0.01);
    }

    .read-status {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        color: #10b981;
    }

    .modal-actions {
        display: flex;
        gap: 12px;
    }

    .modal-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        border-radius: 12px;
        font-size: 0.9rem;
        font-weight: 500;
        border: none;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .modal-btn.secondary {
        background: rgba(255, 255, 255, 0.05);
        color: rgba(255, 255, 255, 0.7);
    }

    .modal-btn.secondary:hover {
        background: rgba(255, 255, 255, 0.1);
        color: white;
    }

    .modal-btn.danger {
        background: rgba(239, 68, 68, 0.1);
        color: #f87171;
    }

    .modal-btn.danger:hover {
        background: rgba(239, 68, 68, 0.2);
    }

    /* Animations */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(15px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .page-header { padding: 24px; }
        .header-content { flex-direction: column; gap: 16px; align-items: flex-start; }
        .main-content { padding: 24px; }
        .message-item { padding: 16px 20px; flex-wrap: wrap; }
        .message-preview { max-width: 100%; }
        .action-btns { opacity: 1; }
    }
</style>

<main class="inbox-container">
    <!-- Ambient Glow -->
    <div class="ambient-glow glow-1"></div>
    <div class="ambient-glow glow-2"></div>

    <!-- Header -->
    <header class="page-header">
        <div class="header-content">
            <div class="header-left">
                <div class="header-icon">
                    <i class="fa-regular fa-envelope"></i>
                </div>
                <div class="header-text">
                    <h1>Gelen Kutusu</h1>
                    <p>Portfolyonuza gelen mesajları yönetin</p>
                </div>
            </div>
            <div class="header-stats">
                <div class="stat-badge total">
                    <i class="fa-regular fa-envelope"></i>
                    @Model.Count() Mesaj
                </div>
                <div class="stat-badge unread">
                    <span class="pulse-dot"></span>
                    @Model.Count(x => x.IsRead == false) Okunmamış
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Filter Tabs -->
        <div class="filter-tabs">
            <button class="filter-btn active" data-filter="all">
                <i class="fa-solid fa-inbox"></i>
                Tümü
            </button>
            <button class="filter-btn" data-filter="unread">
                <i class="fa-solid fa-envelope"></i>
                Okunmamış
            </button>
            <button class="filter-btn" data-filter="read">
                <i class="fa-regular fa-envelope-open"></i>
                Okunmuş
            </button>
        </div>

        <!-- Messages Card -->
        <div class="messages-card">
            @if (Model.Any())
            {
                var index = 0;
                foreach (var item in Model)
                {
                    var isUnread = item.IsRead == false;
                    <div class="message-item @(isUnread ? "unread" : "read")"
                         data-id="@item.MessageId"
                         onclick="openMessage(@item.MessageId)"
                         style="animation-delay: @(0.1 + index * 0.05)s;">

                        <!-- Avatar -->
                        <div class="avatar-wrapper">
                            <div class="avatar @(isUnread ? "unread" : "read")">
                                @item.SenderName?.Substring(0, 1).ToUpper()
                            </div>
                            @if (isUnread)
                            {
                                <div class="unread-badge"></div>
                            }
                        </div>

                        <!-- Content -->
                        <div class="message-content">
                            <div class="message-header">
                                <h4 class="sender-name">@item.SenderName</h4>
                                <span class="subject-badge @GetSubjectClass(item.MessageSubject)">
                                    @item.MessageSubject
                                </span>
                            </div>
                            <p class="sender-email">@item.SenderEmail</p>
                            <p class="message-preview">
                                @(item.MessageText?.Length > 80 ? item.MessageText.Substring(0, 80) + "..." : item.MessageText)
                            </p>
                        </div>

                        <!-- Meta -->
                        <div class="message-meta">
                            <div class="message-time">
                                <div class="date">@(item.SendDate.HasValue ? item.SendDate.Value.ToString("dd MMM") : "")</div>
                                <div class="time">@(item.SendDate.HasValue ? item.SendDate.Value.ToString("HH:mm") : "")</div>
                            </div>
                            <div class="action-btns">
                                <button class="action-btn view" onclick="event.stopPropagation(); openMessage(@item.MessageId)" title="Görüntüle">
                                    <i class="fa-regular fa-eye"></i>
                                </button>
                                <a href="/Message/DeleteMessage/@item.MessageId" class="action-btn delete" onclick="event.stopPropagation();" title="Sil">
                                    <i class="fa-regular fa-trash-can"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    index++;
                }
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="fa-regular fa-envelope"></i>
                    </div>
                    <h3>Henüz mesaj yok</h3>
                    <p>Portfolyonuza gelen mesajlar burada görünecek.</p>
                </div>
            }
        </div>
    </div>
</main>

<!-- Message Modal -->
<div id="messageModal" class="modal-overlay">
    <div class="modal-backdrop" onclick="closeModal()"></div>
    <div class="modal-container">
        <div class="modal-header">
            <div class="modal-header-left">
                <div class="modal-avatar" id="modalAvatar">?</div>
                <div>
                    <h3 class="modal-sender-name" id="modalSenderName">Gönderen</h3>
                    <p class="modal-sender-email" id="modalSenderEmail">email@example.com</p>
                </div>
            </div>
            <button class="modal-close" onclick="closeModal()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="modal-body">
            <div class="modal-meta">
                <span class="subject-badge job" id="modalSubject">Konu</span>
                <div class="modal-date">
                    <i class="fa-regular fa-clock"></i>
                    <span id="modalDate">--</span>
                    <span>•</span>
                    <span id="modalTime">--:--</span>
                </div>
            </div>
            <div class="modal-message-box">
                <p class="modal-message-text" id="modalMessageText">Mesaj içeriği yükleniyor...</p>
            </div>
        </div>
        <div class="modal-footer">
            <div class="read-status">
                <i class="fa-solid fa-circle-check"></i>
                Okundu olarak işaretlendi
            </div>
            <div class="modal-actions">
                <a href="#" class="modal-btn danger" id="modalDeleteBtn">
                    <i class="fa-regular fa-trash-can"></i>
                    Sil
                </a>
                <button class="modal-btn secondary" onclick="closeModal()">Kapat</button>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetSubjectClass(string? subject)
    {
        return subject switch
        {
            "İş Teklifi" => "job",
            "Web / API Geliştirme" => "dev",
            "Eğitim / Kurumsal Talep" => "edu",
            _ => "other"
        };
    }
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function openMessage(id) {
        fetch(`/Message/GetMessageDetails/${id}`)
            .then(response => response.json())
            .then(data => {
                document.getElementById('modalAvatar').textContent = data.senderName.charAt(0).toUpperCase();
                document.getElementById('modalSenderName').textContent = data.senderName;
                document.getElementById('modalSenderEmail').textContent = data.senderEmail;
                document.getElementById('modalSubject').textContent = data.subject;
                document.getElementById('modalDate').textContent = data.sendDate;
                document.getElementById('modalTime').textContent = data.sendTime;
                document.getElementById('modalMessageText').textContent = data.messageText;
                document.getElementById('modalDeleteBtn').href = `/Message/DeleteMessage/${data.messageId}`;

                const subjectEl = document.getElementById('modalSubject');
                subjectEl.className = 'subject-badge ' + getSubjectClass(data.subject);

                const messageRow = document.querySelector(`.message-item[data-id="${id}"]`);
                if (messageRow && messageRow.classList.contains('unread')) {
                    messageRow.classList.remove('unread');
                    messageRow.classList.add('read');
                    const avatar = messageRow.querySelector('.avatar');
                    if (avatar) {
                        avatar.classList.remove('unread');
                        avatar.classList.add('read');
                    }
                    const badge = messageRow.querySelector('.unread-badge');
                    if (badge) badge.remove();
                    updateUnreadCount();
                }

                document.getElementById('messageModal').classList.add('active');
                document.body.style.overflow = 'hidden';
            })
            .catch(error => console.error('Error:', error));
    }

    function getSubjectClass(subject) {
        switch(subject) {
            case 'İş Teklifi': return 'job';
            case 'Web / API Geliştirme': return 'dev';
            case 'Eğitim / Kurumsal Talep': return 'edu';
            default: return 'other';
        }
    }

    function closeModal() {
        document.getElementById('messageModal').classList.remove('active');
        document.body.style.overflow = 'auto';
    }

    function updateUnreadCount() {
        const unreadCount = document.querySelectorAll('.message-item.unread').length;
        const badge = document.querySelector('.stat-badge.unread');
        if (badge) {
            badge.innerHTML = `<span class="pulse-dot"></span>${unreadCount} Okunmamış`;
        }
    }

    // Filter functionality
    document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            this.classList.add('active');

            const filter = this.dataset.filter;
            document.querySelectorAll('.message-item').forEach(item => {
                if (filter === 'all') {
                    item.style.display = 'flex';
                } else if (filter === 'unread') {
                    item.style.display = item.classList.contains('unread') ? 'flex' : 'none';
                } else if (filter === 'read') {
                    item.style.display = item.classList.contains('read') ? 'flex' : 'none';
                }
            });
        });
    });

    // SweetAlert for delete
    document.addEventListener("DOMContentLoaded", function() {
        const deleteValue = '@TempData["Delete"]';
        if (deleteValue) {
            Swal.fire({
                title: 'Silindi!',
                text: deleteValue,
                icon: 'success',
                confirmButtonText: 'Tamam',
                background: '#151525',
                color: '#ffffff',
                confirmButtonColor: '#6366f1'
            });
        }
    });

    // Close modal on escape
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeModal();
    });
</script>
