@model List<Experience>
@{
    ViewData["Title"] = "Deneyimler";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    /* Base Container */
    .experience-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #0a0a12 0%, #12121e 50%, #0d1117 100%);
        position: relative;
        overflow: hidden;
    }

    /* Ambient Glow */
    .ambient-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        pointer-events: none;
        z-index: 0;
    }

    .glow-1 {
        width: 450px;
        height: 450px;
        background: radial-gradient(circle, rgba(139, 92, 246, 0.1) 0%, transparent 70%);
        top: -15%;
        left: -10%;
        animation: pulse-glow 8s ease-in-out infinite;
    }

    .glow-2 {
        width: 350px;
        height: 350px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.08) 0%, transparent 70%);
        bottom: -10%;
        right: -5%;
        animation: pulse-glow 10s ease-in-out infinite;
        animation-delay: 3s;
    }

    @@keyframes pulse-glow {
        0%, 100% { opacity: 0.5; transform: scale(1); }
        50% { opacity: 1; transform: scale(1.1); }
    }

    /* Header */
    .page-header {
        position: relative;
        z-index: 10;
        padding: 32px 40px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        background: rgba(10, 10, 18, 0.8);
        backdrop-filter: blur(20px);
    }

    .header-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: 1200px;
        margin: 0 auto;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .header-icon {
        width: 56px;
        height: 56px;
        border-radius: 18px;
        background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(99, 102, 241, 0.2));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: #c4b5fd;
        box-shadow: 0 8px 32px rgba(139, 92, 246, 0.15);
    }

    .header-text h1 {
        font-size: 1.75rem;
        font-weight: 700;
        color: white;
        margin: 0 0 4px 0;
        letter-spacing: -0.02em;
    }

    .header-text p {
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.5);
        margin: 0;
    }

    .add-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 24px;
        background: linear-gradient(135deg, #8b5cf6, #6366f1);
        border: none;
        border-radius: 14px;
        color: white;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 8px 25px rgba(139, 92, 246, 0.3);
    }

    .add-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 35px rgba(139, 92, 246, 0.4);
        color: white;
    }

    .add-btn i {
        transition: transform 0.3s ease;
    }

    .add-btn:hover i {
        transform: rotate(90deg);
    }

    /* Main Content */
    .main-content {
        position: relative;
        z-index: 5;
        padding: 32px 40px 80px;
        max-width: 1200px;
        margin: 0 auto;
    }

    /* Stats Row */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 32px;
    }

    @@media (max-width: 768px) {
        .stats-row { grid-template-columns: 1fr; }
        .page-header { padding: 24px; }
        .main-content { padding: 24px; }
        .header-content { flex-direction: column; gap: 16px; align-items: flex-start; }
    }

    .stat-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(20px);
        border-radius: 20px;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 16px;
        transition: all 0.3s ease;
        animation: fadeInUp 0.5s ease-out forwards;
    }

    .stat-card:hover {
        transform: translateY(-3px);
    }

    .stat-card.purple {
        border: 1px solid rgba(139, 92, 246, 0.2);
        background: linear-gradient(135deg, rgba(139, 92, 246, 0.08), transparent);
    }

    .stat-card.blue {
        border: 1px solid rgba(59, 130, 246, 0.2);
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.08), transparent);
    }

    .stat-card.green {
        border: 1px solid rgba(16, 185, 129, 0.2);
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.08), transparent);
    }

    .stat-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: white;
    }

    .stat-icon.purple {
        background: linear-gradient(135deg, #8b5cf6, #6366f1);
        box-shadow: 0 8px 20px rgba(139, 92, 246, 0.3);
    }

    .stat-icon.blue {
        background: linear-gradient(135deg, #3b82f6, #6366f1);
        box-shadow: 0 8px 20px rgba(59, 130, 246, 0.3);
    }

    .stat-icon.green {
        background: linear-gradient(135deg, #10b981, #059669);
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
    }

    .stat-value {
        font-size: 1.75rem;
        font-weight: 700;
        color: white;
        margin-bottom: 2px;
    }

    .stat-label {
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.5);
    }

    /* Table Card */
    .table-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 24px;
        overflow: hidden;
        animation: fadeInUp 0.5s ease-out 0.2s both;
    }

    .table-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, rgba(139, 92, 246, 0.5), transparent);
    }

    /* Data Table */
    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

    .data-table thead tr {
        background: rgba(0, 0, 0, 0.2);
    }

    .data-table th {
        padding: 16px 24px;
        text-align: left;
        font-size: 0.7rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.4);
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .data-table th:last-child {
        text-align: right;
    }

    .data-table tbody tr {
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        transition: all 0.3s ease;
        animation: fadeInUp 0.4s ease-out forwards;
    }

    .data-table tbody tr:hover {
        background: rgba(139, 92, 246, 0.05);
    }

    .data-table td {
        padding: 20px 24px;
        vertical-align: middle;
    }

    /* Cells */
    .id-badge {
        width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(139, 92, 246, 0.15);
        border-radius: 12px;
        font-weight: 700;
        color: #a78bfa;
        font-size: 0.9rem;
    }

    .position-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .position-dot {
        width: 8px;
        height: 8px;
        background: linear-gradient(135deg, #8b5cf6, #6366f1);
        border-radius: 50%;
    }

    .position-name {
        font-weight: 600;
        color: white;
        font-size: 0.95rem;
    }

    .company-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid rgba(59, 130, 246, 0.2);
        border-radius: 10px;
        color: #60a5fa;
        font-weight: 500;
        font-size: 0.85rem;
    }

    .description-text {
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.85rem;
        max-width: 280px;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .date-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.2);
        border-radius: 10px;
        color: #6ee7b7;
        font-weight: 500;
        font-size: 0.85rem;
    }

    /* Actions */
    .actions-cell {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 10px 16px;
        border-radius: 10px;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .action-btn.edit {
        background: rgba(245, 158, 11, 0.1);
        border: 1px solid rgba(245, 158, 11, 0.25);
        color: #fcd34d;
    }

    .action-btn.edit:hover {
        background: rgba(245, 158, 11, 0.2);
        transform: translateY(-2px);
    }

    .action-btn.delete {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.25);
        color: #fca5a5;
    }

    .action-btn.delete:hover {
        background: rgba(239, 68, 68, 0.2);
        transform: translateY(-2px);
    }

    /* Empty State */
    .empty-state {
        padding: 80px 40px;
        text-align: center;
    }

    .empty-icon {
        width: 100px;
        height: 100px;
        margin: 0 auto 24px;
        border-radius: 50%;
        background: rgba(139, 92, 246, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        color: rgba(139, 92, 246, 0.4);
    }

    .empty-state h3 {
        font-size: 1.25rem;
        font-weight: 600;
        color: white;
        margin: 0 0 8px 0;
    }

    .empty-state p {
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.4);
        margin: 0 0 24px 0;
    }

    /* Animations */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Mobile Table */
    @@media (max-width: 900px) {
        .data-table thead { display: none; }

        .data-table tbody tr {
            display: block;
            padding: 20px;
            margin-bottom: 16px;
            background: rgba(255, 255, 255, 0.02);
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.06);
        }

        .data-table td {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        }

        .data-table td:last-child {
            border-bottom: none;
            justify-content: flex-end;
        }

        .data-table td::before {
            content: attr(data-label);
            font-weight: 600;
            color: rgba(255, 255, 255, 0.4);
            font-size: 0.75rem;
            text-transform: uppercase;
        }

        .description-text {
            max-width: 200px;
            text-align: right;
        }
    }
</style>

<main class="experience-container">
    <!-- Ambient Glow -->
    <div class="ambient-glow glow-1"></div>
    <div class="ambient-glow glow-2"></div>

    <!-- Header -->
    <header class="page-header">
        <div class="header-content">
            <div class="header-left">
                <div class="header-icon">
                    <i class="fa-solid fa-briefcase"></i>
                </div>
                <div class="header-text">
                    <h1>Deneyimler</h1>
                    <p>İş deneyimlerinizi ve kariyer geçmişinizi yönetin</p>
                </div>
            </div>
            <a href="/Experience/CreateExperience" class="add-btn">
                <i class="fa-solid fa-plus"></i>
                Yeni Deneyim Ekle
            </a>
        </div>
    </header>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Stats Row -->
        <div class="stats-row">
            <div class="stat-card purple" style="animation-delay: 0.1s;">
                <div class="stat-icon purple">
                    <i class="fa-solid fa-briefcase"></i>
                </div>
                <div>
                    <div class="stat-value">@Model.Count</div>
                    <div class="stat-label">Toplam Deneyim</div>
                </div>
            </div>
            <div class="stat-card blue" style="animation-delay: 0.15s;">
                <div class="stat-icon blue">
                    <i class="fa-solid fa-building"></i>
                </div>
                <div>
                    <div class="stat-value">@Model.Select(x => x.CompanyName).Distinct().Count()</div>
                    <div class="stat-label">Farklı Firma</div>
                </div>
            </div>
            <div class="stat-card green" style="animation-delay: 0.2s;">
                <div class="stat-icon green">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div>
                    <div class="stat-value">Aktif</div>
                    <div class="stat-label">Profil Durumu</div>
                </div>
            </div>
        </div>

        <!-- Table Card -->
        <div class="table-card">
            @if (Model.Count > 0)
            {
                <table class="data-table">
                    <thead>
                    <tr>
                        <th style="width: 70px;">No</th>
                        <th>Pozisyon</th>
                        <th>Firma</th>
                        <th>Açıklama</th>
                        <th>Tarih</th>
                        <th>İşlemler</th>
                    </tr>
                    </thead>
                    <tbody>
                    @{ var count = 0; }
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr style="animation-delay: @(0.1 + count * 0.05)s;">
                            <td data-label="No">
                                <span class="id-badge">@count</span>
                            </td>
                            <td data-label="Pozisyon">
                                <div class="position-cell">
                                    <span class="position-dot"></span>
                                    <span class="position-name">@item.Title</span>
                                </div>
                            </td>
                            <td data-label="Firma">
                                    <span class="company-badge">
                                        <i class="fa-solid fa-building"></i>
                                        @item.CompanyName
                                    </span>
                            </td>
                            <td data-label="Açıklama">
                                <span class="description-text">@item.Description</span>
                            </td>
                            <td data-label="Tarih">
                                    <span class="date-badge">
                                        <i class="fa-regular fa-calendar"></i>
                                        @item.WorkDate
                                    </span>
                            </td>
                            <td data-label="İşlemler">
                                <div class="actions-cell">
                                    <a href="/Experience/UpdateExperience/@item.ExperianceId" class="action-btn edit">
                                        <i class="fa-solid fa-pen"></i>
                                        Güncelle
                                    </a>
                                    <a href="/Experience/DeleteExperience/@item.ExperianceId" class="action-btn delete" onclick="return confirm('Bu kaydı silmek istediğinize emin misiniz?')">
                                        <i class="fa-regular fa-trash-can"></i>
                                        Sil
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="fa-solid fa-briefcase"></i>
                    </div>
                    <h3>Henüz deneyim eklenmemiş</h3>
                    <p>Yeni bir deneyim ekleyerek başlayın</p>
                    <a href="/Experience/CreateExperience" class="add-btn">
                        <i class="fa-solid fa-plus"></i>
                        Deneyim Ekle
                    </a>
                </div>
            }
        </div>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const deleteValue = '@TempData["Delete"]';
        if (deleteValue) {
            Swal.fire({
                title: 'Silindi!',
                text: deleteValue,
                icon: 'success',
                confirmButtonText: 'Tamam',
                background: '#151525',
                color: '#ffffff',
                confirmButtonColor: '#8b5cf6'
            });
        }
    });
</script>
