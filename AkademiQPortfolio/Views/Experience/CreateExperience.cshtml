@model Experience
@{
    ViewData["Title"] = "Yeni Deneyim Oluşturma Sayfası";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    /* ======================================================
       FIXED & RESPONSIVE CREATE EXPERIENCE PAGE
       ====================================================== */

    html, body {
        height: auto;
        overflow-x: hidden;
    }

    .page-section {
        padding: 2rem 1rem 4rem;
        background: linear-gradient(135deg, #0f0f1a 0%, #1a1a2e 50%, #16213e 100%);
        position: relative;
    }

    /* Background Effect (SAFE) */
    .page-section::before {
        content: '';
        position: fixed;
        inset: 0;
        background:
            radial-gradient(circle at 20% 80%, rgba(120,119,198,.08), transparent 50%),
            radial-gradient(circle at 80% 20%, rgba(255,119,198,.06), transparent 50%);
        z-index: 0;
        pointer-events: none;
    }

    /* Top Bar */
    .top-bar {
        position: relative;
        z-index: 2;
        margin-bottom: 2rem;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .75rem 1.25rem;
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 12px;
        color: #fff;
        text-decoration: none;
        transition: .3s;
    }

    .btn-back:hover {
        background: rgba(255,255,255,.12);
        transform: translateX(-4px);
    }

    /* Header */
    .page-header {
        text-align: center;
        position: relative;
        z-index: 2;
        margin-bottom: 2.5rem;
    }

    .page-header-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 1rem;
        background: linear-gradient(135deg,#a78bfa,#818cf8);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        color: #fff;
    }

    .page-header h1 {
        font-size: 1.8rem;
        font-weight: 800;
        background: linear-gradient(135deg,#fff,#a78bfa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .page-header p {
        color: rgba(255,255,255,.5);
        font-size: .95rem;
    }

    /* Steps */
    .progress-steps {
        display: flex;
        justify-content: center;
        gap: .75rem;
        flex-wrap: wrap;
        position: relative;
        z-index: 2;
        margin-bottom: 2rem;
    }

    .step {
        padding: .6rem 1.2rem;
        border-radius: 999px;
        font-size: .85rem;
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(255,255,255,.1);
        color: rgba(255,255,255,.5);
    }

    .step.active {
        background: rgba(167,139,250,.15);
        border-color: rgba(167,139,250,.4);
        color: #a78bfa;
    }

    /* Card */
    .form-card {
        max-width: 720px;
        margin: 0 auto;
        padding: 2rem;
        background: rgba(255,255,255,.03);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 24px;
        position: relative;
        z-index: 2;
    }

    /* Inputs */
    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-group label {
        display: block;
        margin-bottom: .5rem;
        color: rgba(255,255,255,.85);
        font-weight: 600;
    }

    .form-input,
    .form-textarea {
        width: 100%;
        padding: .9rem 1rem;
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 12px;
        color: #fff;
    }

    .form-input:focus,
    .form-textarea:focus {
        outline: none;
        border-color: #a78bfa;
        background: rgba(167,139,250,.08);
    }

    .form-textarea {
        resize: vertical;
        min-height: 120px;
    }

    /* Actions */
    .form-actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
    }

    .btn-cancel {
        flex: 1;
        padding: .9rem;
        text-align: center;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,.2);
        color: rgba(255,255,255,.6);
        text-decoration: none;
    }

    .btn-success {
        flex: 1;
        padding: .9rem;
        border-radius: 12px;
        background: linear-gradient(135deg,#10b981,#059669);
        border: none;
        color: #fff;
        font-weight: 600;
        cursor: pointer;
    }

    /* Tips */
    .tips-card {
        max-width: 720px;
        margin: 2rem auto 0;
        padding: 1.5rem;
        background: rgba(251,191,36,.06);
        border: 1px solid rgba(251,191,36,.2);
        border-radius: 16px;
        position: relative;
        z-index: 2;
    }
</style>

<div class="page-section">

    <div class="top-bar">
        <a href="/Experience/Index" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i> Geri Dön
        </a>
    </div>

    <div class="page-header">
        <div class="page-header-icon">
            <i class="fa-solid fa-briefcase"></i>
        </div>
        <h1>Yeni Deneyim Ekle</h1>
        <p>Kariyer geçmişinize yeni bir deneyim ekleyin</p>
    </div>

    <div class="progress-steps">
        <div class="step active">Temel Bilgiler</div>
        <div class="step">Detaylar</div>
        <div class="step">Tamamla</div>
    </div>

    <div class="form-card">
        <form method="post" action="/Experience/CreateExperience">

            <div class="form-group">
                <label>Pozisyon</label>
                <input name="Title" class="form-input" required />
            </div>

            <div class="form-group">
                <label>Firma Adı</label>
                <input name="CompanyName" class="form-input" required />
            </div>

            <div class="form-group">
                <label>Çalışma Tarihi</label>
                <input name="WorkDate" class="form-input" required />
            </div>

            <div class="form-group">
                <label>Açıklama</label>
                <textarea name="Description" class="form-textarea" required></textarea>
            </div>

            <div class="form-actions">
                <a href="/Experience/Index" class="btn-cancel">İptal</a>
                <button class="btn-success">Kaydet</button>
            </div>

        </form>
    </div>

    <div class="tips-card">
        <strong>İpucu:</strong> Açıklamada yaptığın işleri net ve kısa yaz.
    </div>

</div>
