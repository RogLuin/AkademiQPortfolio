@model Education
@{
    ViewData["Title"] = "Yeni Eğitim Ekle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    /* Base Container */
    .create-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #0a0a12 0%, #12121e 50%, #0d1117 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        position: relative;
        overflow: hidden;
    }

    /* Ambient Glow */
    .ambient-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        pointer-events: none;
    }

    .glow-1 {
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.1) 0%, transparent 70%);
        top: -10%;
        right: -10%;
        animation: pulse-glow 8s ease-in-out infinite;
    }

    .glow-2 {
        width: 350px;
        height: 350px;
        background: radial-gradient(circle, rgba(139, 92, 246, 0.08) 0%, transparent 70%);
        bottom: -10%;
        left: -10%;
        animation: pulse-glow 10s ease-in-out infinite;
        animation-delay: 3s;
    }

    @@keyframes pulse-glow {
        0%, 100% { opacity: 0.5; transform: scale(1); }
        50% { opacity: 1; transform: scale(1.1); }
    }

    /* Form Wrapper */
    .form-wrapper {
        position: relative;
        z-index: 10;
        width: 100%;
        max-width: 600px;
    }

    /* Progress Steps */
    .progress-steps {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        margin-bottom: 32px;
    }

    .step {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .step-number {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .step-number.active {
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        color: white;
        box-shadow: 0 8px 20px rgba(59, 130, 246, 0.3);
    }

    .step-number.inactive {
        background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.3);
    }

    .step-text {
        font-size: 0.85rem;
        font-weight: 500;
    }

    .step-text.active { color: white; }
    .step-text.inactive { color: rgba(255, 255, 255, 0.3); }

    .step-divider {
        width: 40px;
        height: 2px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 2px;
    }

    /* Form Card */
    .form-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
        position: relative;
    }

    .form-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, #3b82f6, #8b5cf6, #3b82f6);
        background-size: 200% 100%;
        animation: gradient-slide 3s ease infinite;
    }

    @@keyframes gradient-slide {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    .form-body {
        padding: 40px;
    }

    .form-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 8px;
    }

    .form-header i {
        font-size: 1.25rem;
        color: #60a5fa;
    }

    .form-header h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: white;
        margin: 0;
    }

    .form-description {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.4);
        margin: 0 0 32px 0;
        padding-left: 32px;
    }

    /* Form Group */
    .form-group {
        margin-bottom: 24px;
        animation: fadeInUp 0.5s ease-out forwards;
    }

    .form-label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.75rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.5);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 12px;
        margin-left: 4px;
    }

    .label-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .label-dot.blue { background: #3b82f6; }
    .label-dot.purple { background: #8b5cf6; }
    .label-dot.green { background: #10b981; }

    .input-wrapper {
        position: relative;
    }

    .input-icon-box {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

    .input-icon-box.blue { background: rgba(59, 130, 246, 0.15); color: #60a5fa; }
    .input-icon-box.purple { background: rgba(139, 92, 246, 0.15); color: #a78bfa; }
    .input-icon-box.green { background: rgba(16, 185, 129, 0.15); color: #6ee7b7; }

    .form-input {
        width: 100%;
        padding: 18px 20px 18px 68px;
        background: rgba(255, 255, 255, 0.03);
        border: 2px solid rgba(255, 255, 255, 0.06);
        border-radius: 16px;
        color: white;
        font-size: 0.95rem;
        font-family: inherit;
        transition: all 0.3s ease;
        outline: none;
        box-sizing: border-box;
    }

    .form-input::placeholder {
        color: rgba(255, 255, 255, 0.25);
    }

    .form-input:hover {
        border-color: rgba(255, 255, 255, 0.1);
    }

    .form-input:focus {
        border-color: rgba(59, 130, 246, 0.5);
        background: rgba(59, 130, 246, 0.05);
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
    }

    .form-input:focus + .input-icon-box.blue,
    .form-input:focus ~ .input-icon-box.blue { background: rgba(59, 130, 246, 0.25); }
    .form-input:focus + .input-icon-box.purple,
    .form-input:focus ~ .input-icon-box.purple { background: rgba(139, 92, 246, 0.25); }
    .form-input:focus + .input-icon-box.green,
    .form-input:focus ~ .input-icon-box.green { background: rgba(16, 185, 129, 0.25); }

    .input-hint {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 8px;
        margin-left: 4px;
        font-size: 0.7rem;
        color: rgba(255, 255, 255, 0.35);
    }

    .validation-error {
        color: #f87171;
        font-size: 0.8rem;
        margin-top: 8px;
        margin-left: 4px;
    }

    /* Tip Box */
    .tip-box {
        background: rgba(59, 130, 246, 0.08);
        border: 1px solid rgba(59, 130, 246, 0.15);
        border-radius: 16px;
        padding: 16px 20px;
        margin-top: 32px;
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .tip-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: rgba(59, 130, 246, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #60a5fa;
        flex-shrink: 0;
    }

    .tip-content h5 {
        font-size: 0.85rem;
        font-weight: 600;
        color: white;
        margin: 0 0 4px 0;
    }

    .tip-content p {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.5);
        margin: 0;
        line-height: 1.5;
    }

    /* Form Footer */
    .form-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .secure-badge {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.4);
    }

    .footer-buttons {
        display: flex;
        gap: 12px;
    }

    .btn-cancel {
        padding: 14px 24px;
        border-radius: 12px;
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.9rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .btn-cancel:hover {
        background: rgba(255, 255, 255, 0.05);
        color: white;
        border-color: rgba(255, 255, 255, 0.2);
    }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 28px;
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        border: none;
        border-radius: 12px;
        color: white;
        font-size: 0.9rem;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 8px 25px rgba(59, 130, 246, 0.3);
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 35px rgba(59, 130, 246, 0.4);
    }

    .btn-submit:active {
        transform: translateY(0);
    }

    /* Help Link */
    .help-link {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 24px;
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.4);
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .help-link:hover {
        color: white;
    }

    /* Animations */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Responsive */
    @@media (max-width: 576px) {
        .form-body {
            padding: 28px;
        }

        .progress-steps {
            flex-wrap: wrap;
            gap: 12px;
        }

        .step-divider {
            display: none;
        }

        .form-footer {
            flex-direction: column;
            gap: 16px;
        }

        .secure-badge {
            order: 2;
        }

        .footer-buttons {
            width: 100%;
        }

        .btn-cancel, .btn-submit {
            flex: 1;
            justify-content: center;
        }
    }
</style>

<main class="create-container">
    <!-- Ambient Glow -->
    <div class="ambient-glow glow-1"></div>
    <div class="ambient-glow glow-2"></div>

    <div class="form-wrapper">
        <!-- Progress Steps -->
        <div class="progress-steps" style="animation: fadeInUp 0.4s ease-out;">
            <div class="step">
                <div class="step-number active">1</div>
                <span class="step-text active">Bilgileri Gir</span>
            </div>
            <div class="step-divider"></div>
            <div class="step">
                <div class="step-number inactive">2</div>
                <span class="step-text inactive">Kaydet</span>
            </div>
            <div class="step-divider"></div>
            <div class="step">
                <div class="step-number inactive"><i class="fa-solid fa-check" style="font-size: 0.7rem;"></i></div>
                <span class="step-text inactive">Tamamla</span>
            </div>
        </div>

        <!-- Form Card -->
        <div class="form-card" style="animation: fadeInUp 0.5s ease-out 0.1s both;">
            <form method="post" class="form-body">
                <div class="form-header">
                    <i class="fa-solid fa-pen-to-square"></i>
                    <h3>Eğitim Detayları</h3>
                </div>
                <p class="form-description">Aşağıdaki bilgileri eksiksiz doldurunuz.</p>

                <!-- School Name -->
                <div class="form-group" style="animation-delay: 0.15s;">
                    <label class="form-label">
                        <span class="label-dot blue"></span>
                        Okul / Kurum Adı
                    </label>
                    <div class="input-wrapper">
                        <input type="text" asp-for="Title" class="form-input" placeholder="Örn: İstanbul Teknik Üniversitesi">
                        <div class="input-icon-box blue">
                            <i class="fa-solid fa-building-columns"></i>
                        </div>
                    </div>
                    <span asp-validation-for="Title" class="validation-error"></span>
                </div>

                <!-- Department -->
                <div class="form-group" style="animation-delay: 0.2s;">
                    <label class="form-label">
                        <span class="label-dot purple"></span>
                        Bölüm / Alan
                    </label>
                    <div class="input-wrapper">
                        <input type="text" asp-for="Department" class="form-input" placeholder="Örn: Bilgisayar Mühendisliği">
                        <div class="input-icon-box purple">
                            <i class="fa-solid fa-code-branch"></i>
                        </div>
                    </div>
                    <span asp-validation-for="Department" class="validation-error"></span>
                </div>

                <!-- Date Range -->
                <div class="form-group" style="animation-delay: 0.25s;">
                    <label class="form-label">
                        <span class="label-dot green"></span>
                        Tarih Aralığı
                    </label>
                    <div class="input-wrapper">
                        <input type="text" asp-for="EducationDate" class="form-input" placeholder="Örn: 2018 - 2022">
                        <div class="input-icon-box green">
                            <i class="fa-regular fa-calendar"></i>
                        </div>
                    </div>
                    <div class="input-hint">
                        <i class="fa-solid fa-circle-info"></i>
                        Yıl aralığı veya 'Devam Ediyor' şeklinde giriniz.
                    </div>
                    <span asp-validation-for="EducationDate" class="validation-error"></span>
                </div>

                <!-- Tip Box -->
                <div class="tip-box" style="animation: fadeInUp 0.5s ease-out 0.3s both;">
                    <div class="tip-icon">
                        <i class="fa-solid fa-lightbulb"></i>
                    </div>
                    <div class="tip-content">
                        <h5>İpucu</h5>
                        <p>Eğitim bilgilerinizi detaylı girmeniz portfolyonuzun profesyonel görünmesine yardımcı olur.</p>
                    </div>
                </div>

                <!-- Form Footer -->
                <div class="form-footer" style="animation: fadeInUp 0.5s ease-out 0.35s both;">
                    <div class="secure-badge">
                        <i class="fa-solid fa-lock"></i>
                        Bilgileriniz güvende
                    </div>
                    <div class="footer-buttons">
                        <a href="/Education/Index" class="btn-cancel">Vazgeç</a>
                        <button type="submit" class="btn-submit">
                            <i class="fa-solid fa-save"></i>
                            Kaydet
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Help Link -->
        <a href="#" class="help-link" style="animation: fadeInUp 0.5s ease-out 0.4s both;">
            <i class="fa-regular fa-circle-question"></i>
            Yardıma mı ihtiyacınız var?
        </a>
    </div>
</main>
