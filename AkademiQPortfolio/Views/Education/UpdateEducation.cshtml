@model Education
@{
    ViewData["Title"] = "Eğitim Güncelle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    /* Base Container */
    .update-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #0a0a12 0%, #12121e 50%, #0d1117 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        position: relative;
        overflow: hidden;
    }

    /* Ambient Glow */
    .ambient-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        pointer-events: none;
    }

    .glow-1 {
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(245, 158, 11, 0.1) 0%, transparent 70%);
        top: -10%;
        right: -10%;
        animation: pulse-glow 8s ease-in-out infinite;
    }

    .glow-2 {
        width: 350px;
        height: 350px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.08) 0%, transparent 70%);
        bottom: -10%;
        left: -10%;
        animation: pulse-glow 10s ease-in-out infinite;
        animation-delay: 3s;
    }

    @@keyframes pulse-glow {
        0%, 100% { opacity: 0.5; transform: scale(1); }
        50% { opacity: 1; transform: scale(1.1); }
    }

    /* Form Wrapper */
    .form-wrapper {
        position: relative;
        z-index: 10;
        width: 100%;
        max-width: 600px;
    }

    /* Mode Indicators */
    .mode-indicators {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-bottom: 28px;
    }

    .mode-badge {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .mode-badge.edit {
        background: rgba(245, 158, 11, 0.1);
        border: 1px solid rgba(245, 158, 11, 0.2);
        color: #fcd34d;
    }

    .mode-badge.edit .pulse-dot {
        width: 8px;
        height: 8px;
        background: #f59e0b;
        border-radius: 50%;
        animation: pulse-dot 2s infinite;
    }

    .mode-badge.id {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.5);
    }

    @@keyframes pulse-dot {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }

    /* Form Card */
    .form-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
        position: relative;
    }

    .form-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, #f59e0b, #3b82f6, #f59e0b);
        background-size: 200% 100%;
        animation: gradient-slide 3s ease infinite;
    }

    @@keyframes gradient-slide {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    .form-body {
        padding: 40px;
    }

    .form-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 8px;
    }

    .form-header i {
        font-size: 1.25rem;
        color: #f59e0b;
    }

    .form-header h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: white;
        margin: 0;
        flex: 1;
    }

    .editing-badge {
        padding: 6px 12px;
        background: rgba(245, 158, 11, 0.1);
        border: 1px solid rgba(245, 158, 11, 0.2);
        border-radius: 8px;
        font-size: 0.7rem;
        font-weight: 600;
        color: #fcd34d;
    }

    .form-description {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.4);
        margin: 0 0 32px 0;
        padding-left: 32px;
    }

    /* Form Group */
    .form-group {
        margin-bottom: 24px;
        animation: fadeInUp 0.5s ease-out forwards;
    }

    .form-label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.75rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.5);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 12px;
        margin-left: 4px;
    }

    .label-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .label-dot.amber { background: #f59e0b; }
    .label-dot.blue { background: #3b82f6; }
    .label-dot.green { background: #10b981; }

    .input-wrapper {
        position: relative;
    }

    .input-icon-box {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

    .input-icon-box.amber { background: rgba(245, 158, 11, 0.15); color: #fcd34d; }
    .input-icon-box.blue { background: rgba(59, 130, 246, 0.15); color: #60a5fa; }
    .input-icon-box.green { background: rgba(16, 185, 129, 0.15); color: #6ee7b7; }

    .form-input {
        width: 100%;
        padding: 18px 20px 18px 68px;
        background: rgba(255, 255, 255, 0.03);
        border: 2px solid rgba(255, 255, 255, 0.06);
        border-radius: 16px;
        color: white;
        font-size: 0.95rem;
        font-family: inherit;
        transition: all 0.3s ease;
        outline: none;
        box-sizing: border-box;
    }

    .form-input::placeholder {
        color: rgba(255, 255, 255, 0.25);
    }

    .form-input:hover {
        border-color: rgba(255, 255, 255, 0.1);
    }

    .form-input:focus {
        border-color: rgba(245, 158, 11, 0.5);
        background: rgba(245, 158, 11, 0.05);
        box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.1);
    }

    .input-hint {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 8px;
        margin-left: 4px;
        font-size: 0.7rem;
        color: rgba(255, 255, 255, 0.35);
    }

    .validation-error {
        color: #f87171;
        font-size: 0.8rem;
        margin-top: 8px;
        margin-left: 4px;
    }

    /* Warning Box */
    .warning-box {
        background: rgba(245, 158, 11, 0.08);
        border: 1px solid rgba(245, 158, 11, 0.15);
        border-radius: 16px;
        padding: 16px 20px;
        margin-top: 32px;
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .warning-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: rgba(245, 158, 11, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fcd34d;
        flex-shrink: 0;
    }

    .warning-content h5 {
        font-size: 0.85rem;
        font-weight: 600;
        color: white;
        margin: 0 0 4px 0;
    }

    .warning-content p {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.5);
        margin: 0;
        line-height: 1.5;
    }

    /* Form Footer */
    .form-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .save-note {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.4);
    }

    .save-note i { color: #10b981; }

    .footer-buttons {
        display: flex;
        gap: 12px;
    }

    .btn-cancel {
        padding: 14px 24px;
        border-radius: 12px;
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.9rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .btn-cancel:hover {
        background: rgba(255, 255, 255, 0.05);
        color: white;
        border-color: rgba(255, 255, 255, 0.2);
    }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 28px;
        background: linear-gradient(135deg, #f59e0b, #d97706);
        border: none;
        border-radius: 12px;
        color: white;
        font-size: 0.9rem;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 8px 25px rgba(245, 158, 11, 0.3);
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 35px rgba(245, 158, 11, 0.4);
    }

    .btn-submit:active {
        transform: translateY(0);
    }

    /* Additional Actions */
    .additional-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 24px;
        margin-top: 24px;
    }

    .action-link {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8rem;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .action-link.delete {
        color: rgba(239, 68, 68, 0.6);
    }

    .action-link.delete:hover {
        color: #f87171;
    }

    .action-link.help {
        color: rgba(255, 255, 255, 0.4);
    }

    .action-link.help:hover {
        color: white;
    }

    .action-divider {
        color: rgba(255, 255, 255, 0.1);
    }

    /* Animations */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Responsive */
    @@media (max-width: 576px) {
        .form-body {
            padding: 28px;
        }

        .mode-indicators {
            flex-direction: column;
        }

        .form-footer {
            flex-direction: column;
            gap: 16px;
        }

        .save-note {
            order: 2;
        }

        .footer-buttons {
            width: 100%;
        }

        .btn-cancel, .btn-submit {
            flex: 1;
            justify-content: center;
        }
    }
</style>

<main class="update-container">
    <!-- Ambient Glow -->
    <div class="ambient-glow glow-1"></div>
    <div class="ambient-glow glow-2"></div>

    <div class="form-wrapper">
        <!-- Mode Indicators -->
        <div class="mode-indicators" style="animation: fadeInUp 0.4s ease-out;">
            <div class="mode-badge edit">
                <span class="pulse-dot"></span>
                Düzenleme Modu
            </div>
            <div class="mode-badge id">
                <i class="fa-solid fa-hashtag"></i>
                ID: @Model.EducationId
            </div>
        </div>

        <!-- Form Card -->
        <div class="form-card" style="animation: fadeInUp 0.5s ease-out 0.1s both;">
            <form method="post" class="form-body">
                <input type="hidden" value="@Model.EducationId" name="EducationId" />

                <div class="form-header">
                    <i class="fa-solid fa-graduation-cap"></i>
                    <h3>Eğitim Detayları</h3>
                    <span class="editing-badge">Düzenleniyor</span>
                </div>
                <p class="form-description">Değişikliklerinizi yapıp kaydedin.</p>

                <!-- School Name -->
                <div class="form-group" style="animation-delay: 0.15s;">
                    <label class="form-label">
                        <span class="label-dot amber"></span>
                        Okul / Kurum Adı
                    </label>
                    <div class="input-wrapper">
                        <input type="text" asp-for="Title" class="form-input" placeholder="Örn: İstanbul Teknik Üniversitesi">
                        <div class="input-icon-box amber">
                            <i class="fa-solid fa-building-columns"></i>
                        </div>
                    </div>
                    <span asp-validation-for="Title" class="validation-error"></span>
                </div>

                <!-- Department -->
                <div class="form-group" style="animation-delay: 0.2s;">
                    <label class="form-label">
                        <span class="label-dot blue"></span>
                        Bölüm / Alan
                    </label>
                    <div class="input-wrapper">
                        <input type="text" asp-for="Department" class="form-input" placeholder="Örn: Bilgisayar Mühendisliği">
                        <div class="input-icon-box blue">
                            <i class="fa-solid fa-code-branch"></i>
                        </div>
                    </div>
                    <span asp-validation-for="Department" class="validation-error"></span>
                </div>

                <!-- Date Range -->
                <div class="form-group" style="animation-delay: 0.25s;">
                    <label class="form-label">
                        <span class="label-dot green"></span>
                        Tarih Aralığı
                    </label>
                    <div class="input-wrapper">
                        <input type="text" asp-for="EducationDate" class="form-input" placeholder="Örn: 2018 - 2022">
                        <div class="input-icon-box green">
                            <i class="fa-regular fa-calendar"></i>
                        </div>
                    </div>
                    <div class="input-hint">
                        <i class="fa-solid fa-circle-info"></i>
                        Yıl aralığı veya 'Devam Ediyor' şeklinde giriniz.
                    </div>
                    <span asp-validation-for="EducationDate" class="validation-error"></span>
                </div>

                <!-- Warning Box -->
                <div class="warning-box" style="animation: fadeInUp 0.5s ease-out 0.3s both;">
                    <div class="warning-icon">
                        <i class="fa-solid fa-lightbulb"></i>
                    </div>
                    <div class="warning-content">
                        <h5>Güncelleme Notu</h5>
                        <p>Değişiklikleriniz kaydedildikten sonra portfolyonuzda hemen görünecektir.</p>
                    </div>
                </div>

                <!-- Form Footer -->
                <div class="form-footer" style="animation: fadeInUp 0.5s ease-out 0.35s both;">
                    <div class="save-note">
                        <i class="fa-solid fa-circle-check"></i>
                        Otomatik kaydedilmez
                    </div>
                    <div class="footer-buttons">
                        <a href="/Education/Index" class="btn-cancel">Vazgeç</a>
                        <button type="submit" class="btn-submit">
                            <i class="fa-solid fa-rotate"></i>
                            Güncelle
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Additional Actions -->
        <div class="additional-actions" style="animation: fadeInUp 0.5s ease-out 0.4s both;">
            <a href="/Education/DeleteEducation/@Model.EducationId" class="action-link delete">
                <i class="fa-regular fa-trash-can"></i>
                Bu kaydı sil
            </a>
            <span class="action-divider">|</span>
            <a href="#" class="action-link help">
                <i class="fa-regular fa-circle-question"></i>
                Yardım
            </a>
        </div>
    </div>
</main>
