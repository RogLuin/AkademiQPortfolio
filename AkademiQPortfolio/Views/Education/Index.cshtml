@model List<Education>
@{
    ViewData["Title"] = "Eğitim Bilgileri";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    /* Base Container */
    .education-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #0a0a12 0%, #12121e 50%, #0d1117 100%);
        position: relative;
        overflow: hidden;
    }

    /* Ambient Glow */
    .ambient-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        pointer-events: none;
        z-index: 0;
    }

    .glow-1 {
        width: 450px;
        height: 450px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.1) 0%, transparent 70%);
        top: -15%;
        left: -10%;
        animation: pulse-glow 8s ease-in-out infinite;
    }

    .glow-2 {
        width: 350px;
        height: 350px;
        background: radial-gradient(circle, rgba(139, 92, 246, 0.08) 0%, transparent 70%);
        bottom: -10%;
        right: -5%;
        animation: pulse-glow 10s ease-in-out infinite;
        animation-delay: 3s;
    }

    @@keyframes pulse-glow {
        0%, 100% { opacity: 0.5; transform: scale(1); }
        50% { opacity: 1; transform: scale(1.1); }
    }

    /* Header */
    .page-header {
        position: relative;
        z-index: 10;
        padding: 32px 40px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        background: rgba(10, 10, 18, 0.8);
        backdrop-filter: blur(20px);
    }

    .header-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: 1200px;
        margin: 0 auto;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .header-icon {
        width: 56px;
        height: 56px;
        border-radius: 18px;
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(139, 92, 246, 0.2));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: #60a5fa;
        box-shadow: 0 8px 32px rgba(59, 130, 246, 0.15);
    }

    .header-text h1 {
        font-size: 1.75rem;
        font-weight: 700;
        color: white;
        margin: 0 0 4px 0;
        letter-spacing: -0.02em;
    }

    .header-text p {
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.5);
        margin: 0;
    }

    .add-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 24px;
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        border: none;
        border-radius: 14px;
        color: white;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 8px 25px rgba(59, 130, 246, 0.3);
    }

    .add-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 35px rgba(59, 130, 246, 0.4);
        color: white;
    }

    /* Main Content */
    .main-content {
        position: relative;
        z-index: 5;
        padding: 32px 40px 80px;
        max-width: 1200px;
        margin: 0 auto;
    }

    /* Stats Row */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 32px;
    }

    @@media (max-width: 768px) {
        .stats-row { grid-template-columns: 1fr; }
        .page-header { padding: 24px; }
        .main-content { padding: 24px; }
        .header-content { flex-direction: column; gap: 16px; align-items: flex-start; }
    }

    .stat-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(20px);
        border-radius: 20px;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 16px;
        transition: all 0.3s ease;
        animation: fadeInUp 0.5s ease-out forwards;
    }

    .stat-card:hover {
        transform: translateY(-3px);
    }

    .stat-card.purple {
        border: 1px solid rgba(139, 92, 246, 0.2);
        background: linear-gradient(135deg, rgba(139, 92, 246, 0.08), transparent);
    }

    .stat-card.blue {
        border: 1px solid rgba(59, 130, 246, 0.2);
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.08), transparent);
    }

    .stat-card.green {
        border: 1px solid rgba(16, 185, 129, 0.2);
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.08), transparent);
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
    }

    .stat-icon.purple {
        background: rgba(139, 92, 246, 0.2);
        color: #c4b5fd;
    }

    .stat-icon.blue {
        background: rgba(59, 130, 246, 0.2);
        color: #93c5fd;
    }

    .stat-icon.green {
        background: rgba(16, 185, 129, 0.2);
        color: #6ee7b7;
    }

    .stat-value {
        font-size: 1.75rem;
        font-weight: 700;
        color: white;
        margin-bottom: 2px;
    }

    .stat-label {
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.5);
    }

    /* Table Card */
    .table-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 24px;
        overflow: hidden;
        animation: fadeInUp 0.5s ease-out 0.2s both;
    }

    .table-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 24px 28px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        background: rgba(255, 255, 255, 0.02);
    }

    .table-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .table-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: rgba(59, 130, 246, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        color: #60a5fa;
    }

    .table-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: white;
        margin: 0 0 4px 0;
    }

    .table-subtitle {
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.4);
        margin: 0;
    }

    .table-badge {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.5);
    }

    /* Data Table */
    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

    .data-table thead tr {
        background: rgba(0, 0, 0, 0.2);
    }

    .data-table th {
        padding: 16px 28px;
        text-align: left;
        font-size: 0.7rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.4);
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .data-table th:last-child {
        text-align: right;
    }

    .data-table tbody tr {
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        transition: all 0.3s ease;
        animation: fadeInUp 0.4s ease-out forwards;
    }

    .data-table tbody tr:hover {
        background: linear-gradient(90deg, rgba(59, 130, 246, 0.05), transparent);
    }

    .data-table td {
        padding: 20px 28px;
    }

    /* Education Cell */
    .education-cell {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .education-icon {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(139, 92, 246, 0.1));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: #60a5fa;
        transition: all 0.3s ease;
    }

    .data-table tbody tr:hover .education-icon {
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        color: white;
        transform: scale(1.05);
    }

    .education-info h4 {
        font-size: 0.95rem;
        font-weight: 600;
        color: white;
        margin: 0 0 4px 0;
    }

    .education-info span {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.4);
    }

    /* Department Cell */
    .department-cell {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .department-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #3b82f6;
        animation: pulse-dot 2s infinite;
    }

    @@keyframes pulse-dot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(0.8); }
    }

    .department-name {
        color: rgba(255, 255, 255, 0.8);
        font-size: 0.9rem;
    }

    /* Date Badge */
    .date-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.6);
    }

    .date-badge i {
        color: #8b5cf6;
    }

    /* Actions */
    .actions-cell {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        opacity: 0.5;
        transition: opacity 0.3s ease;
    }

    .data-table tbody tr:hover .actions-cell {
        opacity: 1;
    }

    .action-btn {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.05);
        color: rgba(255, 255, 255, 0.5);
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .action-btn.edit:hover {
        background: rgba(59, 130, 246, 0.15);
        color: #60a5fa;
        transform: scale(1.1);
    }

    .action-btn.delete:hover {
        background: rgba(239, 68, 68, 0.15);
        color: #f87171;
        transform: scale(1.1);
    }

    /* Empty State */
    .empty-state {
        padding: 80px 40px;
        text-align: center;
    }

    .empty-icon {
        width: 100px;
        height: 100px;
        margin: 0 auto 24px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.05);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        color: rgba(255, 255, 255, 0.3);
    }

    .empty-state h3 {
        font-size: 1.25rem;
        font-weight: 600;
        color: white;
        margin: 0 0 8px 0;
    }

    .empty-state p {
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.4);
        margin: 0 0 24px 0;
    }

    /* Animations */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<main class="education-container">
    <!-- Ambient Glow -->
    <div class="ambient-glow glow-1"></div>
    <div class="ambient-glow glow-2"></div>

    <!-- Header -->
    <header class="page-header">
        <div class="header-content">
            <div class="header-left">
                <div class="header-icon">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <div class="header-text">
                    <h1>Eğitim Hayatım</h1>
                    <p>Akademik geçmişinizi buradan yönetebilirsiniz</p>
                </div>
            </div>
            <a href="/Education/CreateEducation" class="add-btn">
                <i class="fa-solid fa-plus"></i>
                Yeni Eğitim Ekle
            </a>
        </div>
    </header>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Stats Row -->
        <div class="stats-row">
            <div class="stat-card purple" style="animation-delay: 0.1s;">
                <div class="stat-icon purple">
                    <i class="fa-solid fa-book-open"></i>
                </div>
                <div>
                    <div class="stat-value">@Model.Count</div>
                    <div class="stat-label">Toplam Eğitim</div>
                </div>
            </div>
            <div class="stat-card blue" style="animation-delay: 0.15s;">
                <div class="stat-icon blue">
                    <i class="fa-solid fa-award"></i>
                </div>
                <div>
                    <div class="stat-value">@Model.Select(e => e.Department).Distinct().Count()</div>
                    <div class="stat-label">Farklı Bölüm</div>
                </div>
            </div>
            <div class="stat-card green" style="animation-delay: 0.2s;">
                <div class="stat-icon green">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div>
                    <div class="stat-value">Aktif</div>
                    <div class="stat-label">Durum</div>
                </div>
            </div>
        </div>

        <!-- Table Card -->
        <div class="table-card">
            <div class="table-header">
                <div class="table-header-left">
                    <div class="table-icon">
                        <i class="fa-solid fa-list"></i>
                    </div>
                    <div>
                        <h3 class="table-title">Eğitim Listesi</h3>
                        <p class="table-subtitle">Tüm eğitim kayıtlarınız</p>
                    </div>
                </div>
                <div class="table-badge">
                    <i class="fa-solid fa-info-circle"></i>
                    @Model.Count Kayıt
                </div>
            </div>

            @if (Model.Count > 0)
            {
                <table class="data-table">
                    <thead>
                    <tr>
                        <th>Kurum / Okul Adı</th>
                        <th>Bölüm</th>
                        <th>Tarih Aralığı</th>
                        <th>İşlemler</th>
                    </tr>
                    </thead>
                    <tbody>
                    @{ var index = 0; }
                    @foreach (var item in Model)
                    {
                        <tr style="animation-delay: @(0.1 + index * 0.05)s;">
                            <td>
                                <div class="education-cell">
                                    <div class="education-icon">
                                        <i class="fa-solid fa-school"></i>
                                    </div>
                                    <div class="education-info">
                                        <h4>@item.Title</h4>
                                        <span>Eğitim Kurumu</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="department-cell">
                                    <span class="department-dot"></span>
                                    <span class="department-name">@item.Department</span>
                                </div>
                            </td>
                            <td>
                                <div class="date-badge">
                                    <i class="fa-regular fa-calendar"></i>
                                    @item.EducationDate
                                </div>
                            </td>
                            <td>
                                <div class="actions-cell">
                                    <a href="/Education/UpdateEducation/@item.EducationId" class="action-btn edit" title="Düzenle">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <a href="/Education/DeleteEducation/@item.EducationId" class="action-btn delete" title="Sil">
                                        <i class="fa-regular fa-trash-can"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        index++;
                    }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>
                    <h3>Henüz eğitim kaydı yok</h3>
                    <p>İlk eğitim bilginizi ekleyerek başlayın.</p>
                    <a href="/Education/CreateEducation" class="add-btn">
                        <i class="fa-solid fa-plus"></i>
                        Eğitim Ekle
                    </a>
                </div>
            }
        </div>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const value = '@TempData["Delete"]';
        if (value) {
            Swal.fire({
                title: 'Silindi!',
                text: value,
                icon: 'success',
                confirmButtonText: 'Tamam',
                background: '#151525',
                color: '#ffffff',
                confirmButtonColor: '#3b82f6'
            });
        }
    });
</script>
